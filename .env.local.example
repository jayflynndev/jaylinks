# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, used for admin writes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key, used by the Tier 2 AI answer judge (claude-haiku-4-5).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
